{
  "id": "notion",
  "name": "Notion",
  "description": "Notion API for databases and pages",
  "category": "saas",
  "base_url": "https://api.notion.com/v1",
  "auth": {
    "type": "bearer",
    "token_param": "integration_token",
    "header_name": "Authorization",
    "header_template": "Bearer {token}"
  },
  "headers": {"Notion-Version": "2022-06-28"},
  "params": [
    {"name": "integration_token", "label": "Internal Integration Token", "required": true, "secret": true},
    {"name": "database_id", "label": "Database ID", "required": false}
  ],
  "streams": [
    {
      "name": "users",
      "label": "Users",
      "path": "/users",
      "method": "GET",
      "data_path": "results",
      "pagination": {"type": "cursor", "cursor_field": "next_cursor", "cursor_param": "start_cursor", "max_pages": 50}
    },
    {
      "name": "search",
      "label": "Search Pages",
      "path": "/search",
      "method": "GET",
      "data_path": "results",
      "pagination": {"type": "cursor", "cursor_field": "next_cursor", "cursor_param": "start_cursor", "max_pages": 50}
    }
  ]
}
